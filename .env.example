# ─────────────────────────────────────────────────────────────
#  IVORY CAISSE — Configuration
#  Copie ce fichier en ".env" puis remplis tes vraies clés.
#  Sans clés, l'app fonctionne en mode gratuit hors-ligne. Premium n'est
#  jamais débloqué sans confirmation de paiement.
# ─────────────────────────────────────────────────────────────

# CINETPAY : ne rien mettre ici.
# Les clés se configurent dans Netlify (variables CINETPAY_APIKEY et CINETPAY_SITE_ID),
# elles sont lues uniquement par la fonction serveur netlify/functions/pay.mts.

# BUILD STORES
# Mettre true pour un build Google Play / App Store : masque CinetPay afin de
# respecter les règles de paiement des stores jusqu'à l'intégration IAP.
VITE_STORE_BUILD=false

# FIREBASE (sauvegarde cloud Premium)
# → sur console.firebase.google.com > Paramètres du projet > Vos applications (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
